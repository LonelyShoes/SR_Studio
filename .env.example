# Salin menjadi `.env.local` untuk pengembangan lokal, atau isi di
# Vercel → Project → Settings → Environment Variables (lalu redeploy).
# Semua variabel bersifat opsional: tanpa file ini aplikasi memakai nilai bawaan proyek.

# URL Firebase Realtime Database yang dipakai untuk sinkronisasi realtime.
# VITE_FIREBASE_DATABASE_URL=https://nama-proyek-default-rtdb.asia-southeast1.firebasedatabase.app

# ID workspace (ruang data). Ganti hanya bila ingin memisahkan data, mis. untuk uji coba.
# VITE_WORKSPACE_ID=sr_boq_78odeb

# Hash Master Code. Buat dengan: npm run hash:master -- <kode-baru>
# VITE_MASTER_CODE_HASH=

# Email kontak Master yang ditampilkan di aplikasi.
# VITE_MASTER_EMAIL=nama@contoh.com
