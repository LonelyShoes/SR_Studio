{
  "name": "sr-studio-boq-tools",
  "private": true,
  "version": "3.0.0",
  "description": "SR Studio — BoQ/RAB & kalkulator konstruksi dengan kolaborasi realtime (Firebase Realtime Database), PWA offline.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src scripts --ext .js,.jsx,.mjs --max-warnings 0",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\"",
    "test": "vitest run",
    "check": "npm run lint && npm run test && npm run build",
    "package": "node scripts/package-dist.mjs",
    "hash:master": "node scripts/hash-master-code.mjs",
    "verify:cloud": "vite-node scripts/verify-cloud.mjs"
  },
  "dependencies": {
    "@firebase/app": "^0.16.5",
    "@firebase/database": "^1.1.5",
    "lucide-react": "^1.16.0",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.4.49",
    "prettier": "^3.3.0",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "vitest": "^2.1.0"
  }
}
